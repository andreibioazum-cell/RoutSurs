# RoutSurs default configuration: aarch64 "virt" machine.
#
# Derived from Buildroot's configs/qemu_aarch64_virt_defconfig, but without
# the host-qemu emulator package and without the qemu start script: this
# configuration only builds the operating system itself, i.e. the
# cross-toolchain, busybox, the Linux kernel and the root filesystems.
BR2_TARGET_GENERIC_HOSTNAME="routsurs"
BR2_TARGET_GENERIC_ISSUE="Welcome to RoutSurs"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_SYSTEM_DHCP="eth0"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_TAR=y
