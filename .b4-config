# Configuration for the `b4` tool
# See https://b4.docs.kernel.org/en/latest/config.html
#
# RoutSurs does not run a mailing list: patches are sent as GitHub pull
# requests to https://github.com/andreibioazum-cell/RoutSurs.  The helper
# commands below are still useful when preparing a series, and they work the
# same way as in upstream Buildroot.
[b4]
    send-auto-cc-cmd = "./utils/get-developers -e -"
    prep-perpatch-check-cmd = "./utils/check-package -q -p -"

# vim: set filetype=gitconfig:
